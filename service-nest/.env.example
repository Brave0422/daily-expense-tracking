# ===================== 数据库配置 =====================
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=your_password
# 数据库名称
DB_DATABASE=my_cs_logs

# ===================== JWT 配置 =====================
# JWT 密钥（生产环境请使用复杂随机字符串）
JWT_SECRET=please_change_this_secret
# JWT 过期时间（如 7d、24h、60m）
JWT_EXPIRES_IN=7d

# ===================== 运行环境 =====================
# 环境模式：development（开发） / production（生产）
# 开发模式下 send-register-code 和 send-change-password-code 接口会在响应中返回 debugCode
NODE_ENV=development

# ===================== SMTP 邮件配置 =====================
# SMTP 服务器地址（如 smtp.qq.com、smtp.163.com）
MAIL_HOST=
# SMTP 服务器端口（587=STARTTLS, 465=SSL）
MAIL_PORT=587
# 是否使用 SSL 连接（true=465端口, false=587端口 STARTTLS）
MAIL_SECURE=false
# SMTP 发信邮箱账号
MAIL_USER=
# SMTP 授权码（非邮箱登录密码，需在邮箱设置中生成授权码/应用专用密码）
MAIL_PASS=
# 发件人显示名称（可与 MAIL_USER 相同）
MAIL_FROM=
# 验证码过期时间（分钟），默认 5 分钟
MAIL_CODE_EXPIRES_MINUTES=5
# 重复发送冷却时间（秒），默认 60 秒
MAIL_CODE_RESEND_SECONDS=60
